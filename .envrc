use flake
export SOPS_AGE_KEY_FILE=$HOME/.config/sops/age/keys.txt

# Export SOPS-encrypted dev-shell environment variables (env.sops.yaml).
# Edit them with: sops env.sops.yaml
if [[ -f env.sops.yaml ]]; then
  watch_file env.sops.yaml
  eval "$(sops --decrypt --output-type dotenv env.sops.yaml | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | sed 's/^/export /')"
fi

